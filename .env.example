# このファイルを .env にコピーして、実際の値を設定します。
# .env はGitへ追加しないでください。
# 設定変更はBotの再起動で反映します。

# ===== 共通 =====

DISCORD_TOKEN=
LOG_LEVEL=INFO

# 相対パスは、この設定ファイルのある場所を基準に解決します。
RUNTIME_DATA_DIR=./runtime

# DM転送はサーバーを識別できないため共通設定です。
DM_FORWARD_ENABLED=false
DM_FORWARD_USER_ID=

# 機能名はカンマ区切りです。
# welcome, valorant_diagnosis, bump, recruitment, reaction_roles, leave_log
# 空欄の場合、そのサーバーの業務機能は無効です。
# welcomeを有効にする場合、valorant_diagnosisも必要です。

# ===== 本番サーバー =====

# 未使用の場合はGUILD_IDを空欄にしてください。
PROD_GUILD_ID=
PROD_ENABLED_FEATURES=

# 管理者ロールが複数ある場合はカンマ区切り。
PROD_ADMIN_ROLE_IDS=

PROD_WELCOME_CATEGORY_ID=
PROD_MEETING_CATEGORY_ID=
PROD_LOG_CATEGORY_ID=
PROD_MEMBER_ROLE_ID=
PROD_GACHI_ROLE_ID=
PROD_ENJOY_ROLE_ID=

PROD_RULES_CHANNEL_ID=
PROD_RULES_MESSAGE_ID=

# Unicode絵文字、またはカスタム絵文字の数値ID。
PROD_RULES_EMOJI=

# 一般メンバーが閲覧できない管理者専用チャンネル。
PROD_KICK_APPROVAL_CHANNEL_ID=

PROD_VALO_RECRUIT_CHANNEL_ID=
PROD_BUMP_CHANNEL_ID=

# BUMP有効時は、通知元のDISBOARD BotのユーザーIDが必須。
PROD_DISBOARD_BOT_ID=

# 任意。DISBOARDのbumpコマンドID。空欄なら文字で操作を案内。
PROD_DISBOARD_BUMP_COMMAND_ID=

# BUMPの待機時間。未設定・空欄なら7200秒（2時間）。
# この値を短くしても、DISBOARD側の待機時間は短縮されません。
PROD_BUMP_COOLDOWN_SECONDS=7200

PROD_LEAVE_LOG_CHANNEL_ID=

# ゲーム別ロールの詳細な対応設定は、その機能の実装時に追加します。
PROD_REACTION_ROLE_MESSAGE_IDS=

# ===== テストサーバー =====

TEST_GUILD_ID=
TEST_ENABLED_FEATURES=
TEST_ADMIN_ROLE_IDS=

TEST_WELCOME_CATEGORY_ID=
TEST_MEETING_CATEGORY_ID=
TEST_LOG_CATEGORY_ID=
TEST_MEMBER_ROLE_ID=
TEST_GACHI_ROLE_ID=
TEST_ENJOY_ROLE_ID=

TEST_RULES_CHANNEL_ID=
TEST_RULES_MESSAGE_ID=
TEST_RULES_EMOJI=
TEST_KICK_APPROVAL_CHANNEL_ID=

TEST_VALO_RECRUIT_CHANNEL_ID=
TEST_BUMP_CHANNEL_ID=

# BUMP有効時は、通知元のDISBOARD BotのユーザーIDが必須。
TEST_DISBOARD_BOT_ID=

# 任意。DISBOARDのbumpコマンドID。空欄なら文字で操作を案内。
TEST_DISBOARD_BUMP_COMMAND_ID=

# BUMPの待機時間。未設定・空欄なら7200秒（2時間）。
# この値を短くしても、DISBOARD側の待機時間は短縮されません。
TEST_BUMP_COOLDOWN_SECONDS=7200

TEST_LEAVE_LOG_CHANNEL_ID=
TEST_REACTION_ROLE_MESSAGE_IDS=

# VALORANT診断の回答期限。秒数で指定。未設定なら1800秒。
# 診断機能が無効なサーバーでは、この設定は使用しません。
PROD_VALO_DIAGNOSIS_TIMEOUT_SECONDS=1800
TEST_VALO_DIAGNOSIS_TIMEOUT_SECONDS=1800


# ===== Welcome本人待ちの期限 =====
# 設定変更は再起動後に反映します。
# 本番は48時間・72時間固定です。
# Welcome無効時は使用しません。
PROD_WELCOME_REMINDER_SECONDS=172800
PROD_WELCOME_TIMEOUT_SECONDS=259200

# テストも通常は48時間・72時間です。
# 動作確認時のみ、120 / 180に変更すると2分・3分になります。
# リマインド秒数 < 退出確認秒数 としてください。
TEST_WELCOME_REMINDER_SECONDS=172800
TEST_WELCOME_TIMEOUT_SECONDS=259200
